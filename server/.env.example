# VLITE Server Environment Variables
# Copy this file to .env and fill in actual values before running.

# MongoDB Atlas URI (required)
# Get from: MongoDB Atlas -> Clusters -> Connect -> Connect your application
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/vlite?retryWrites=true&w=majority

# JWT Secret (required)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_at_least_64_characters

# JWT Expiry (optional, default: 7d)
JWT_EXPIRES_IN=7d

# Server Port (optional, default: 5000)
PORT=5000

# Node Environment (optional)
NODE_ENV=development

# Client URL for CORS (optional, default: http://localhost:5173)
CLIENT_URL=http://localhost:5173

# CAPTCHA Provider (optional)
# Supported: 'recaptcha-v3', 'hcaptcha', 'none' (simple honeypot for dev only)
CAPTCHA_PROVIDER=none

# reCAPTCHA v3 Site Key (public - safe for frontend)
RECAPTCHA_SITE_KEY=

# reCAPTCHA v3 Secret Key (PRIVATE - never expose to frontend)
RECAPTCHA_SECRET_KEY=

# Cloudinary Image Storage (optional)
# Get from: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis URL for Socket.IO adapter (optional - needed only for multi-instance deployment)
# REDIS_URL=redis://localhost:6379

# Rate Limiting (optional)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
