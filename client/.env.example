# VLITE Client Environment Variables
# Copy to client/.env and fill in actual values
#
# DEVELOPMENT (default): leave both empty.
# The app then uses relative paths (/api/...) which Vite proxies
# to http://localhost:5000 (see client/vite.config.js).
#
# PRODUCTION: set both to your deployed backend.
# VITE_API_URL must include the /api prefix.
# Example:
#   VITE_API_URL=https://your-backend.com/api
#   VITE_SOCKET_URL=https://your-backend.com

VITE_API_URL=
VITE_SOCKET_URL=

# Frontend URL (for reference)
VITE_APP_URL=http://localhost:5174
